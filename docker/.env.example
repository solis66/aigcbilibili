# =============================================================================
# aigcbilibili 容器化 —— 可调参数样例（复制为 docker/.env 后生效）
#
# 用法：
#   cd docker && copy .env.example .env      (Windows)
#   cp .env.example .env                     (Linux/macOS)
# 说明：docker compose 会自动读取与 compose 文件同目录的 .env；若不存在，则使用下方各
#       变量的 ":-默认值"。因此不复制本文件也能一键启动（走默认值）。
# 约束：compose 中所有宿主端口均已变量化（D-11），任何端口冲突只需改本文件。
# =============================================================================

# ---- 宿主端口映射（左=宿主，右=容器，均已在 compose 中变量化）----
MYSQL_HOST_PORT=3306
# ⚠️ 宿主 6379 已被常驻 redis-server 占用（D-11）。redis 容器默认**不发布**到宿主；
#    如需从宿主直连，把 compose 里 redis 的 ports 行取消注释，并把下面这行设为 16379（不要用 6379）。
REDIS_HOST_PORT=16379
# ⚠️ FIX-12：Windows 上这些端口常落在系统**保留（excluded）端口段**（Hyper-V/WSL 动态占用）。
#    落进去的端口 Docker **无权 bind** → **容器创建即失败、且没有任何容器日志**，
#    而 `netstat -ano` / `Get-NetTCPConnection` **查不到任何占用者**（这不是「端口被占用」）。
#    排查命令：netsh int ipv4 show excludedportrange protocol=tcp
#    本机实测保留段含 8805-8904 / 8905-9004 / 9005-9104 / 9181-9280，故实际 .env 已改为
#    minio=19000/19001、nacos=18848、elasticsearch=19200。
#    ⚠️ 保留段随机器与系统重启变化：**换机器务必先查一遍，别照抄端口号**。
MINIO_API_HOST_PORT=19000
MINIO_CONSOLE_HOST_PORT=19001
ROCKETMQ_NAMESRV_HOST_PORT=9876
ROCKETMQ_BROKER_HOST_PORT=10911
ES_HOST_PORT=19200
GATEWAY_HOST_PORT=8200
NOTICE_HOST_PORT=30000
USER_CENTER_HOST_PORT=3000
VIDEO_HOST_PORT=10201
CHAT_HOST_PORT=1688
SEARCH_HOST_PORT=8201
FRONTEND_HOST_PORT=2023

# ---- 凭据 / 标识 ----
# ⚠️ MYSQL_ROOT_PASSWORD 说明（本键本质上不是一个可在线调节项，请读完再改）：
#  1) 仅在 mysql 容器**首次初始化空数据卷**时被读取；数据卷一旦存在，本键被**完全忽略**
#     —— 后续启动不会去修改已存在库的 root 口令。
#  2) 6 个后端的外置 yml（docker/config/*/application*.yml）里数据库口令是**写死**的
#     （username: root / password: user），**必须与这里的值保持一致**；xxl-job-admin 亦经 compose 引用本键。
#  3) 若确要更换口令并使其真正生效：需先 `docker compose down -v` 清空数据卷，再 `docker compose up -d`
#     重新初始化，**并同步修改那 6 份 yml**的 spring.datasource.password；否则会出现
#     mysql 容器口令变了、后端仍用旧口令 → 连库失败。
MYSQL_ROOT_PASSWORD=user
MYSQL_DATABASE=bilibili
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# FIX-14：minio 需要三个桶（user-cover 头像 / video 视频 / video-cover 视频封面），空格分隔
MINIO_BUCKETS=user-cover video video-cover

# ---- 讯飞星火 Spark（AI 对话 / TTI 文生图 / AIPPT 生成 PPT）----
# ⚠️ 这三项在讯飞开放平台是相互独立的服务与计费，appId 很可能不是同一个。
#   对话（v3.5）必填；TTI / AIPPT 未单独配置时会回落复用对话凭据（与改造前行为一致）。
#   真实值只写在 docker/.env（已 gitignore），本文件保持空值。
# ⚠️ APISecret 直接填控制台原文，不要做任何编码/解码处理 —— HMAC-SHA256 用的就是原始字符串。
#    本机实测（2026-09-23 真实握手）：原文 → 101 Switching Protocols；
#    把它 base64 解成 hex 再去签名 → 401 {"message":"HMAC signature does not match"}。
SPARK_CHAT_APP_ID=
SPARK_CHAT_API_KEY=
SPARK_CHAT_API_SECRET=
# 若控制台里 TTI 文生图 / AIPPT 属于另外的应用，取消注释并填各自凭据
#SPARK_TTI_APP_ID=
#SPARK_TTI_API_KEY=
#SPARK_TTI_API_SECRET=
#SPARK_AIPPT_APP_ID=
#SPARK_AIPPT_API_KEY=
#SPARK_AIPPT_API_SECRET=

# ---- Elasticsearch 堆（D-08：单节点、512m 堆）----
ES_JAVA_OPTS=-Xms512m -Xmx512m

# ---- Sleuth/Zipkin 采样率（F-16：默认 0.1 = 原实际行为；设 1 可在 Zipkin 看到全链路）----
# ⚠️ 优先级提示：本键**通过 compose environment: 注入容器**（6 个后端均注入），
#    Spring 环境变量优先级高于 yml 内 ${ZIPKIN_SAMPLER_PROBABILITY:-0.1} 的默认值，
#    故容器内实际采样率以此处（或 compose 内联默认 0.1）为准；改本文件即可全局调节。
ZIPKIN_SAMPLER_PROBABILITY=0.1

# ---- 各后端 JVM 堆上限（D-08：16GB 机器生死线，逐服务显式设置）----
#  -Duser.home=/app 为每个后端必带项（D-07：防 RocketMQ 客户端日志外溢，对应上一轮 D7）
GATEWAY_JAVA_OPTS=-Xms256m -Xmx512m -Duser.home=/app
NOTICE_JAVA_OPTS=-Xms512m -Xmx768m -Duser.home=/app
USER_CENTER_JAVA_OPTS=-Xms256m -Xmx512m -Duser.home=/app
VIDEO_JAVA_OPTS=-Xms512m -Xmx768m -Duser.home=/app
CHAT_JAVA_OPTS=-Xms256m -Xmx512m -Duser.home=/app
SEARCH_JAVA_OPTS=-Xms384m -Xmx640m -Duser.home=/app

# ---- RocketMQ 堆（D-08：broker 默认堆过大，必须显式限制）----
NAMESRV_JVM_XMS=256m
NAMESRV_JVM_XMX=256m
BROKER_JVM_XMS=768m
BROKER_JVM_XMX=768m
